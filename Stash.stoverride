name: Stash 精细化分流
desc: 保留机场节点，重建策略组与分流规则；含 AI、流媒体、社交、Apple、金融及游戏分流。
homepage: https://github.com/ZacBi/Rules
author: Customized for user's node naming

proxy-groups: #!replace
  - name: 全部节点
    type: select
    include-all: true
    filter: "(?i)^(?!.*(剩余|流量|到期|过期|套餐|官网|订阅|更新|重置|用户|倍率|余额|traffic|expire|subscription|reset)).*$"

  - name: 自动选择
    type: url-test
    include-all: true
    filter: "(?i)^(?!.*(剩余|流量|到期|过期|套餐|官网|订阅|更新|重置|用户|倍率|余额|traffic|expire|subscription|reset)).*$"
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 100
    lazy: true

  - name: 节点选择
    type: select
    proxies:
      - 自动选择
      - 全部节点
      - 日本节点
      - 美国节点
      - 新加坡节点
      - 德国节点
      - AI专线自动
      - DIRECT

  - name: 日本节点
    type: url-test
    include-all: true
    filter: "(?i)(日本|Japan|(^|[^A-Za-z])JP([^A-Za-z]|$)|Tokyo|Osaka)"
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 100
    lazy: true

  - name: 美国节点
    type: url-test
    include-all: true
    filter: "(?i)(美国|USA?|United States|(^|[^A-Za-z])US([^A-Za-z]|$)|Los Angeles|San Jose|Seattle)"
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 100
    lazy: true

  - name: 新加坡节点
    type: url-test
    include-all: true
    filter: "(?i)(新加坡|狮城|Singapore|(^|[^A-Za-z])SG([^A-Za-z]|$))"
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 100
    lazy: true

  - name: 德国节点
    type: url-test
    include-all: true
    filter: "(?i)(德国|Germany|(^|[^A-Za-z])DE([^A-Za-z]|$)|Frankfurt)"
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 100
    lazy: true

  - name: AI专线自动
    type: url-test
    include-all: true
    filter: "(?i)(高速\\s*AI|AI流媒体|AI专线)"
    url: https://www.gstatic.com/generate_204
    interval: 600
    tolerance: 100
    lazy: true

  - name: AI平台
    type: select
    proxies:
      - AI专线自动
      - 美国节点
      - 日本节点
      - 新加坡节点
      - 节点选择

  - name: ChatGPT
    type: select
    proxies:
      - AI专线自动
      - 美国节点
      - 日本节点
      - 新加坡节点
      - 节点选择

  - name: Claude
    type: select
    proxies:
      - 美国节点
      - 日本节点
      - 新加坡节点
      - AI专线自动
      - 节点选择

  - name: Gemini
    type: select
    proxies:
      - 美国节点
      - 日本节点
      - 新加坡节点
      - AI专线自动
      - 节点选择

  - name: Google服务
    type: select
    proxies:
      - 日本节点
      - 新加坡节点
      - 美国节点
      - 节点选择
      - 自动选择

  - name: YouTube
    type: select
    proxies:
      - 日本节点
      - 美国节点
      - 新加坡节点
      - 节点选择
      - 自动选择

  - name: Netflix
    type: select
    proxies:
      - 美国节点
      - 日本节点
      - 新加坡节点
      - 节点选择
      - 自动选择

  - name: 流媒体
    type: select
    proxies:
      - 节点选择
      - 自动选择
      - 日本节点
      - 美国节点
      - 新加坡节点

  - name: TikTok
    type: select
    proxies:
      - 美国节点
      - 日本节点
      - 新加坡节点
      - 节点选择
      - DIRECT

  - name: Telegram社交
    type: select
    proxies:
      - 日本节点
      - 新加坡节点
      - 美国节点
      - 节点选择
      - 自动选择

  - name: Apple服务
    type: select
    proxies:
      - DIRECT
      - 节点选择
      - 日本节点
      - 美国节点
      - 新加坡节点

  - name: 微软服务
    type: select
    proxies:
      - DIRECT
      - 节点选择
      - 日本节点
      - 美国节点
      - 新加坡节点

  - name: 金融服务
    type: select
    proxies:
      - DIRECT
      - 节点选择
      - 日本节点
      - 新加坡节点
      - 美国节点

  - name: 游戏平台
    type: select
    proxies:
      - DIRECT
      - 日本节点
      - 新加坡节点
      - 美国节点
      - 节点选择

  - name: 国内直连
    type: select
    proxies:
      - DIRECT
      - 节点选择

  - name: 广告拦截
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 漏网之鱼
    type: select
    proxies:
      - 节点选择
      - 自动选择
      - DIRECT

rule-providers: #!replace
  advertising:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Advertising/Advertising.yaml
    path: ./ruleset/Advertising.yaml
    interval: 86400
  lan:
    type: http
