rules: #!replace
  - DOMAIN,localhost,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR6,::1/128,DIRECT,no-resolve

  # AI：各平台独立策略
  - DOMAIN-SUFFIX,openai.com,ChatGPT
  - DOMAIN-SUFFIX,chatgpt.com,ChatGPT
  - RULE-SET,openai,ChatGPT
  - RULE-SET,claude,Claude
  - RULE-SET,anthropic,Claude
  - RULE-SET,gemini,Gemini
  - RULE-SET,copilot,AI平台

  # 独立服务分流
  - RULE-SET,youtube,YouTube
  - RULE-SET,netflix,Netflix
  - RULE-SET,spotify,流媒体
  - RULE-SET,tiktok,TikTok
  - RULE-SET,telegram,Telegram社交
  - RULE-SET,discord,Telegram社交
  - RULE-SET,twitter,Telegram社交
  - RULE-SET,google,Google服务
  - RULE-SET,microsoft,微软服务
  - RULE-SET,apple,Apple服务

  # 金融网站
  - RULE-SET,longbridge,金融服务
  - RULE-SET,ibkr,金融服务
  - RULE-SET,tigerfintech,金融服务

  # 游戏
  - RULE-SET,steam,游戏平台
  - RULE-SET,epic,游戏平台

  # 国内、局域网与广告
  - RULE-SET,advertising,广告拦截
  - RULE-SET,lan,国内直连
  - RULE-SET,bytedance,国内直连
  - RULE-SET,china,国内直连
  - GEOIP,CN,国内直连

  # 最终匹配
  - MATCH,漏网之鱼
